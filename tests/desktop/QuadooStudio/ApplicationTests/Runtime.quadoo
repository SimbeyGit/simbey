		get
		{
			return Form;
		}
		set (value)
		{
			Form = value;
		}
	}
	MissingPluginForm()
	{
		Form = Form.Create(this);
	}
};

function MissingPlugin()
{
	try
	{
		var failed = new MissingPluginForm();
	}
	catch (error)
	{
		return true;
	}
	return false;
}


var menuClicks = 0;
interface IMenuForm
{
	virtual function MenuClick(args) = 0;
};
class MenuForm : extern(Form), IMenuForm
{
	property var ChildButton;
	property var MainMenu1;
	property var FileMenu;
	property var OpenItem;
	property var RecentMenu;
	property var RecentItem;
	property var Separator1;
	property var DisabledItem;
	property var EditMenu;
	property var LongMenu;
	property var PopupMenu1;
	property var PopupItem;
	property __QuadooRoot
	{
		get
		{
			return Form;
		}
		set (value)
		{
			Form = value;
		}
	}
	MenuForm()
	{
		Form = Form.Create(this);
	}
	virtual function MenuClick(args)
	{
		if(args.Sender.Name == "OpenItem" || args.Sender.Name == "RecentItem" || args.Sender.Name == "PopupItem")
		{
			menuClicks++;
		}
		return true;
	}
};
function Menus()
{
	menuClicks = 0;
	var form = new MenuForm();
	var root = form.__QuadooRoot;
	if(root.MainMenu != form.MainMenu1 || root.PopupMenu != form.PopupMenu1)
	{
		throw "Menu references did not resolve to their component wrappers";
	}
	form.OpenItem.SetEnabled(false);
	form.OpenItem.Click();
	if(form.OpenItem.GetEnabled() || form.OpenItem.Enabled || menuClicks != 0)
	{
		throw "Disabled menu item accepted a click";
	}
	form.OpenItem.SetEnabled(true);
	form.OpenItem.Click();
	if(!form.OpenItem.GetChecked() || !form.OpenItem.Checked || menuClicks != 1)
	{
		throw "Menu AutoCheck or OnClick binding failed";
	}
	form.OpenItem.SetChecked(true);
	form.OpenItem.Toggle();
	if(form.OpenItem.GetChecked())
	{
		throw "MenuItem.Toggle failed";
	}
	form.OpenItem.Checked = true;
	form.RecentItem.Click();
	form.PopupItem.Click();
	if(menuClicks != 3)
	{
		throw "Nested or popup menu event binding failed";
	}
	root.MainMenu = null;
	if(root.MainMenu != null)
	{
		throw "Main menu was not detached";
	}
	root.MainMenu = form.MainMenu1;
	form.ChildButton.PopupMenu = form.PopupMenu1;
	if(form.ChildButton.PopupMenu != form.PopupMenu1)
	{
		throw "PopupMenu assignment did not round trip";
	}
	form.ChildButton.PopupMenu = null;
	root.PopupMenu = null;
	root.PopupMenu = form.PopupMenu1;
	root.Close();
	return 42;
}
