#include "TreeRuntime.quadoo"
#include "ListRuntime.quadoo"
#include "VirtualListRuntime.quadoo"
#include "ImageButtonRuntime.quadoo"
#include "ProgressBarRuntime.quadoo"
#include "StatusBarRuntime.quadoo"
#include "CanvasRuntime.quadoo"
#include "SpriteRuntime.quadoo"

var created = 0;
var clicked = 0;
var ticks = 0;
var cancelClose = true;
var retainedArgs;
var pulses = 0;
var destroyed = 0;
var throwTimer = false;
var pluginsCreated = 0;
var pluginsDestroyed = 0;

function PluginCounts()
{
	return pluginsCreated * 10 + pluginsDestroyed;
}

interface IStartupForm
{
	virtual function Created(args) = 0;
	virtual function Clicked(args) = 0;
	virtual function Tick(args) = 0;
	virtual function Closing(args) = 0;
	virtual function Pulse(args) = 0;
	virtual function Destroyed(args) = 0;
	virtual function PluginCreated(args) = 0;
	virtual function PluginDestroyed(args) = 0;
};

class StartupForm : extern(Form), IStartupForm
{
	property __QuadooRoot
	{
		get
		{
			return Form;
		}
		set (value)
		{
			Form = value;
		}
	}
	property var Button1;
	property var Panel1;
	property var List1;
	property var Timer1;
	property var Meter1;
	property var DirectPlugin;
	property var FallbackPlugin;
	StartupForm()
	{
		Form = Form.Create(this);
	}
	virtual function Created(args)
	{
		created++;
		if(DirectPlugin.Ping() != 73 || FallbackPlugin.Ping() != 73)
		{
			throw "Plugin references were not installed before OnCreate";
		}
		Button1.Caption = "Bound before OnCreate";
		Form.ModalResult = 4;
		return false;
	}
	virtual function PluginCreated(args)
	{
		if(DirectPlugin.Ping() != 73 || FallbackPlugin.Ping() != 73)
		{
			throw "Plugin references were not installed before component OnCreate";
		}
		pluginsCreated++;
		return true;
	}
	virtual function PluginDestroyed(args)
	{
		pluginsDestroyed++;
		return true;
	}
	virtual function Clicked(args)
	{
		clicked++;
		retainedArgs = args;
		return true;
	}
	virtual function Tick(args)
	{
		if(throwTimer)
		{
			throw "Deliberate callback failure";
		}
		ticks++;
		if(ticks >= 2)
		{
			cancelClose = false;
			Form.Close();
		}
		return true;
	}
	virtual function Closing(args)
	{
		args.Cancel = cancelClose;
		retainedArgs = args;
		return true;
	}
	virtual function Pulse(args)
	{
		pulses++;
		args.Value = args.Value + 7;
		return true;
	}
	virtual function Destroyed(args)
	{
		destroyed++;
		return true;
	}
};

interface IDetailsFrame
{
};
class DetailsFrame : extern(Frame), IDetailsFrame
{
	property __QuadooRoot
	{
		get
		{
			return Frame;
		}
		set (value)
		{
			Frame = value;
		}
	}
	property var Label1;
	DetailsFrame(Owner)
	{
		Frame = Frame.Create(this, Owner);
	}
};

interface IDeferredForm
{
};
class DeferredForm : extern(Form), IDeferredForm
{
	property __QuadooRoot
	{
		get
		{
			return Form;
		}
		set (value)
		{
			Form = value;
		}
	}
	function Start()
	{
		Form = Form.Create(this);
	}
};

function Make()
{
	return new StartupForm();
}
function Deferred()
{
	return new DeferredForm();
}
function Counts()
{
	return created + clicked * 10 + ticks * 100;
}
function SavedEventName()
{
	return retainedArgs.EventName;
}
function SavedArguments()
{
	return retainedArgs;
}
function ArmTimerThrow()
{
	throwTimer = true;
}
function DestroyedCount()
{
	return destroyed;
}
function MakeFrames(Owner)
{
	var first = new DetailsFrame(Owner);
	var second = new DetailsFrame(Owner);
	first.Label1.Caption = "First frame";
	second.Label1.Caption = "Second frame";
	return first;
}
function NoOwner()
{
	try
	{
		var invalid = new DetailsFrame(null);
	}
	catch (error)
	{
		return true;
	}
	return false;
}
function Pulses()
{
	return pulses;
}

interface IThrowForm
{
	virtual function ThrowOnCreate(args) = 0;
};
class ThrowForm : extern(Form), IThrowForm
{
	property __QuadooRoot
	{
		get
		{
			return Form;
		}
		set (value)
		{
			Form = value;
		}
	}
	ThrowForm()
	{
		Form = Form.Create(this);
	}
	virtual function ThrowOnCreate(args)
	{
		throw "Deliberate initialization failure";
	}
};
function MakeThrow()
{
	return new ThrowForm();
}

