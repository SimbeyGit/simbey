#include <windows.h>
#include <commctrl.h>
#include "PackagesResource.h"
IDD_QF_PACKAGES DIALOGEX 0, 0, 420, 245
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Control Packages"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_QF_PACKAGE_LIST, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 8, 404, 151
    EDITTEXT IDC_QF_PACKAGE_DETAIL, 8, 166, 404, 44, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "&Install...", IDC_QF_PACKAGE_INSTALL, 8, 220, 62, 17
    PUSHBUTTON "&Remove", IDC_QF_PACKAGE_REMOVE, 76, 220, 62, 17
    DEFPUSHBUTTON "Close", IDOK, 350, 220, 62, 17
END
