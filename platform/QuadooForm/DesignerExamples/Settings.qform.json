{
  "schemaVersion": 1,
  "type": "Form",
  "name": "SettingsForm",
  "id": "{836934A1-4A55-496F-89F1-000000000001}",
  "properties": {
    "Caption": "Application settings",
    "Width": 540,
    "Height": 360,
    "BorderStyle": "Dialog",
    "BorderIcons": 9,
    "WindowState": "Normal",
    "FormStyle": "Normal",
    "AutoScroll": false,
    "Icon": null
  },
  "events": { "OnCreate": "Settings_Create" },
  "children": [
    {
      "type": "TabControl", "name": "settingsTabs",
